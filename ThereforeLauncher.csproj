<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>assets/icons/launcher.ico</ApplicationIcon>
    <Version>0.4.0</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);website/**;releases/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup><Resource Include="assets/icons/*.png" /><Resource Include="assets/icons/launcher.ico" /><Compile Remove="checks/**/*.cs" /></ItemGroup>
</Project>
